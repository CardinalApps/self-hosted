{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".npmrc", ".nvmrc"],
  "globalEnv": ["NODE_ENV", "TZ"],
  "globalPassThroughEnv": [
    "APP_ENCRYPTION_KEY",
    "CARDINAL_POSTGRES",
    "DISABLE_RATE_LIMIT",
    "LETSENCRYPT_ACCOUNT_KEY",
    "LETSENCRYPT_STAGING_TEST",
    "LOG_LEVEL",
    "MONGODB_CONNECTION_STRING",
    "MONGODB_URI",
    "MONGODB_DB_NAME",
    "NUM_PROXIES",
    "POPULARITY_SERVER_HTTP_PORT",
    "RA_CONNECT_DNS_CAA_RECORDS",
    "RA_STAGING_TEST_SUFFIX",
    "RATE_LIMIT_IP_WHITELIST",
    "TRENDS_REFRESH_INTERVAL_MINUTES",
    "TRUST_PROXY",
    "npm_package_version"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_*", "NEXT_PUBLIC_*"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "$TURBO_ROOT$/config/typescript/*.json"],
      "outputs": ["build/**", "dist/**", ".next/**", "!.next/cache/**"]
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "serve": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/config/eslint/*.js"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/config/typescript/*.json"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e:fts": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e:ui": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:e2e:fts:ui": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "test:e2e:install": {
      "cache": false
    },
    "@cardinalapps/ui#serve": {
      "dependsOn": ["build:storybook"],
      "cache": false,
      "persistent": true
    },
    "@cardinalapps/media-server#bundle": {
      "dependsOn": [
        "@cardinalapps/admin-web#build",
        "@cardinalapps/cinema-web#build",
        "@cardinalapps/music-web#build",
        "@cardinalapps/photos-web#build"
      ],
      "outputs": ["public/admin/**", "public/cinema/**", "public/music/**", "public/photos/**"]
    },
    "@cardinalapps/media-server#build:bin": {
      "dependsOn": ["build", "bundle"],
      "outputs": ["bin/prod/**"]
    }
  }
}
